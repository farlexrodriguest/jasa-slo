---
import { getCollection, render } from 'astro:content';
import PageLayout from '../components/shared/PageLayout.astro';
import BlockRenderer from '../components/blocks/BlockRenderer.astro';

export async function getStaticPaths() {
  const pages = (await getCollection('pages'))
    .filter((page) => !page.data.draft && page.data.slug !== 'home')
    .sort((a, b) => a.data.order - b.data.order);
  return pages.map((page) => ({ params: { slug: page.data.slug }, props: { page } }));
}

const { page } = Astro.props;
const { Content } = await render(page);
---
<PageLayout page={page.data}>
  {page.data.blocks.map((block) => <BlockRenderer block={block} />)}
  <div class="page-markdown mt-8"><Content /></div>
</PageLayout>
