---
import { getCollection, render } from 'astro:content';
import PageLayout from '../components/shared/PageLayout.astro';
import BlockRenderer from '../components/blocks/BlockRenderer.astro';
import { webPageSchema } from '../utils/schema.ts';

export async function getStaticPaths() {
  const pages = (await getCollection('pages'))
    .filter((page) => !page.data.draft && page.data.slug !== 'home' && !page.data.section)
    .sort((a, b) => a.data.order - b.data.order);
  return pages.map((page) => ({ params: { slug: page.data.slug }, props: { page } }));
}

const { page } = Astro.props;
const { Content } = await render(page);
const base = Astro.site?.href ?? Astro.url.origin;
const jsonLd = [webPageSchema({
  base,
  path: `/${page.data.slug}/`,
  title: page.data.title,
  description: page.data.description,
  dateModified: page.data.updatedDate,
})];
---
<PageLayout page={page.data} jsonLd={jsonLd}>
  {page.data.blocks.map((block) => <BlockRenderer block={block} />)}
  <div class="page-markdown mt-8"><Content /></div>
</PageLayout>
