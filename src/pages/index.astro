---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/shared/SiteHeader.astro';
import SiteFooter from '../components/shared/SiteFooter.astro';
const services=[
{n:'01',title:'SLO Tegangan Rendah',text:'Panduan kebutuhan pemeriksaan instalasi pemanfaatan tegangan rendah.',href:'/layanan/slo-tr/'},
{n:'02',title:'SLO Tegangan Menengah',text:'Informasi awal sertifikasi untuk instalasi dengan kebutuhan teknis lebih kompleks.',href:'/layanan/slo-tm/'},
{n:'03',title:'Pendampingan NIDI',text:'Memahami identitas instalasi dan dokumen yang perlu disiapkan.',href:'/layanan/nidi/'},
{n:'04',title:'Konsultasi kebutuhan',text:'Mulai dari klasifikasi instalasi dan kelengkapan dokumen.',href:'/kontak/'}
];
---
<BaseLayout title="Beranda" description="Panduan dan informasi pendampingan SLO serta NIDI untuk kebutuhan instalasi listrik.">
<SiteHeader />
<main id="main-content">
<section class="border-b border-[#dfcdb8]">
  <div class="mx-auto grid max-w-[1440px] lg:grid-cols-[1.55fr_.45fr]">
    <div class="px-6 py-20 lg:px-12 lg:py-28">
      <p class="eyebrow mb-8 text-[#a34a17]">Instalasi listrik / sertifikasi / informasi</p>
      <h1 class="max-w-5xl text-[clamp(3.5rem,7.5vw,8rem)] font-extrabold leading-[.99] tracking-[-.075em]">Urusan listrik.<br/><span class="text-[#d4621a]">Lebih terang.</span></h1>
      <p class="mt-10 max-w-xl text-lg leading-8 text-[#624b39]">Kenali kebutuhan Sertifikat Laik Operasi dan NIDI, pahami tahapannya, lalu tentukan langkah berikutnya dengan informasi yang jelas.</p>
      <div class="mt-10 flex flex-wrap gap-3"><a class="bg-[#2a1a0e] px-7 py-4 font-bold text-[#fef3e2] hover:bg-[#d4621a]" href="/layanan/">Jelajahi layanan ↗</a><a class="border border-[#2a1a0e] px-7 py-4 font-bold hover:bg-[#f4ae52]" href="/alur-dan-persyaratan/">Pelajari alur →</a></div>
    </div>
    <aside class="flex flex-col justify-between border-t border-[#dfcdb8] bg-[#f4ae52] p-8 lg:border-l lg:border-t-0 lg:p-10">
      <div class="eyebrow">Catatan lapangan / 001</div>
      <div class="my-20"><div aria-hidden="true" class="text-[clamp(8rem,18vw,17rem)] font-black leading-none tracking-[-.14em]">⚡</div><p class="mt-8 border-t border-[#2a1a0e] pt-5 text-xl font-semibold leading-8">Dokumen yang tepat. Proses yang dipahami. Keputusan yang lebih terarah.</p></div>
      <span class="eyebrow">SLO ≠ NIDI · Kenali perbedaannya</span>
    </aside>
  </div>
</section>
<section class="mx-auto max-w-[1440px] px-6 py-20 lg:px-12 lg:py-28">
  <div class="mb-12 flex flex-wrap items-end justify-between gap-5"><div><p class="eyebrow mb-4 text-[#a34a17]">01 / Apa yang Anda butuhkan?</p><h2 class="text-5xl font-extrabold md:text-7xl">Mulai dari sini.</h2></div><p class="max-w-sm text-[#624b39]">Setiap jenis instalasi memiliki persyaratan berbeda. Pilih topik yang paling mendekati kebutuhan Anda.</p></div>
  <div class="grid border-t border-[#2a1a0e] md:grid-cols-2">{services.map((s)=><a href={s.href} class="group border-b border-[#dfcdb8] px-1 py-10 md:px-8 md:odd:border-r md:odd:border-[#dfcdb8]"><div class="flex items-start justify-between"><span class="eyebrow text-[#a34a17]">{s.n} / Layanan</span><span class="text-2xl transition group-hover:translate-x-1 group-hover:text-[#d4621a]">↗</span></div><h3 class="mt-10 text-3xl font-bold md:text-4xl">{s.title}</h3><p class="mt-4 max-w-sm leading-7 text-[#624b39]">{s.text}</p></a>)}</div>
</section>
<section class="bg-[#2a1a0e] px-6 py-20 text-[#fef3e2] lg:px-12 lg:py-28"><div class="mx-auto grid max-w-[1344px] gap-10 md:grid-cols-[.7fr_1.3fr]"><p class="eyebrow text-[#f4ae52]">02 / Pendekatan kami</p><div><h2 class="text-4xl font-extrabold leading-tight md:text-6xl">Bukan sekadar formulir. <span class="text-[#f4ae52]">Pahami prosesnya.</span></h2><div class="mt-12 grid gap-8 border-t border-[#73513c] pt-8 sm:grid-cols-3">{[['01','Kenali instalasi'],['02','Siapkan dokumen'],['03','Koordinasikan proses']].map(([n,t])=><div><span class="eyebrow text-[#f4ae52]">{n}</span><p class="mt-3 text-xl font-semibold">{t}</p></div>)}</div></div></div></section>
<section class="mx-auto flex max-w-[1440px] flex-wrap items-end justify-between gap-8 px-6 py-20 lg:px-12 lg:py-28"><div><p class="eyebrow mb-5 text-[#a34a17]">03 / Langkah berikutnya</p><h2 class="max-w-3xl text-5xl font-extrabold md:text-7xl">Masih ada yang perlu ditanyakan?</h2></div><a href="/kontak/" class="border-b-2 border-[#d4621a] pb-2 text-xl font-bold hover:text-[#d4621a]">Lihat cara menghubungi kami ↗</a></section>
</main><SiteFooter />
</BaseLayout>
