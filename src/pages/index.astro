---
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/shared/SiteHeader.astro';
import SiteFooter from '../components/shared/SiteFooter.astro';
import BlockRenderer from '../components/blocks/BlockRenderer.astro';

const home = await getEntry('home', 'beranda');
if (!home) throw new Error('Konten beranda tidak ditemukan (src/content/home/beranda.md).');
---
<BaseLayout title={home.data.title} description={home.data.description}>
<SiteHeader />
<main id="main-content">{home.data.blocks.map((block) => <BlockRenderer block={block} />)}</main>
<SiteFooter />
</BaseLayout>
