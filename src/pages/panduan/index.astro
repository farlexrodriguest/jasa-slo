---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/shared/SiteHeader.astro';
import GuideListBlock from '../../components/shared/GuideListBlock.astro';
---
<BaseLayout title="Panduan" description="Panduan alur, persyaratan, dan proses pengurusan SLO dan NIDI.">
  <SiteHeader />
  <main id="main-content" class="mx-auto max-w-[1440px] px-6 py-20 lg:px-12 lg:py-28">
    <p class="eyebrow text-[#a34a17]">Pusat informasi / Panduan</p>
    <h1 class="mt-5 text-5xl font-extrabold md:text-7xl">Panduan proses.</h1>
    <p class="mt-7 max-w-2xl text-lg leading-8 text-[#624b39]">Pelajari tahapan dan dokumen yang perlu disiapkan sebelum memulai proses.</p>
    <GuideListBlock id="daftar-panduan" heading="Panduan terbaru" description="Diurutkan dari pembaruan terakhir." />
  </main>
</BaseLayout>
