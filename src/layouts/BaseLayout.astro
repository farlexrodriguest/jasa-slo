---
import '../styles/global.css';
import { site } from '../config/site';
import SiteFooter from '../components/shared/SiteFooter.astro';
interface Props {title?:string;description?:string;serviceTitle?:string}
const {title,description='Informasi dan pendampingan kebutuhan SLO dan NIDI.',serviceTitle}=Astro.props;
const fullTitle=title?title+' | '+site.name:site.name;
---
<!doctype html>
<html lang="id">
<head>
<meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<meta name="generator" content={Astro.generator} />
<title>{fullTitle}</title><meta name="description" content={description} />
</head>
<body class="min-h-screen"><slot /><SiteFooter serviceTitle={serviceTitle} /></body>
</html>
