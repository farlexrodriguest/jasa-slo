---
import '../styles/global.css';
import { site } from '../config/site';
import SiteFooter from '../components/shared/SiteFooter.astro';
import JsonLd from '../components/seo/JsonLd.astro';

interface Props {
  title?: string;
  description?: string;
  serviceTitle?: string;
  /** URL gambar untuk meta Open Graph (og:image). Kosong = fallback logo. */
  socialImage?: string;
  /** URL kanonik; kosong = mengikuti URL permintaan. */
  canonical?: string;
  /** Jika true, halaman tidak diindeks oleh mesin pencari. */
  noindex?: boolean;
  /** Data schema.org (JSON-LD); objek atau array — dirender di <head>. */
  jsonLd?: Record<string, unknown>[];
}
const {
  title,
  description = 'Informasi dan pendampingan kebutuhan SLO dan NIDI.',
  serviceTitle,
  socialImage,
  canonical,
  noindex = false,
  jsonLd,
} = Astro.props;
const fullTitle = title ? title + ' | ' + site.name : site.name;
const ogImage = socialImage || '/images/logo-jasa-slo.svg';
const canonicalUrl = canonical || Astro.url.href;
const robots = noindex ? 'noindex, nofollow' : 'index, follow';
---
<!doctype html>
<html lang="id">
<head>
<meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<meta name="generator" content={Astro.generator} />
<title>{fullTitle}</title><meta name="description" content={description} />
<meta name="robots" content={robots} />
<link rel="canonical" href={canonicalUrl} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImage} />
<meta property="og:type" content="website" />
<meta property="og:locale" content="id_ID" />
<meta name="twitter:card" content="summary_large_image" />
{jsonLd && jsonLd.length > 0 && <JsonLd data={jsonLd} />}
</head>
<body class="min-h-screen"><slot /><SiteFooter serviceTitle={serviceTitle} /></body>
</html>
