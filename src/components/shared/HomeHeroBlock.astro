---
const { eyebrow, titleLead, titleHighlight, description, primaryCta, primaryHref, secondaryCta, secondaryHref, note, image, imageAlt, supportEyebrow, supportItems } = Astro.props as { eyebrow: string; titleLead: string; titleHighlight: string; description: string; primaryCta: string; primaryHref: string; secondaryCta: string; secondaryHref: string; note: string; image: string; imageAlt: string; supportEyebrow: string; supportItems: Array<{ number: string; title: string; text: string }> };
---
<section class="relative isolate overflow-hidden bg-slate-950 text-white">
  <div class="absolute inset-0 -z-10 bg-[radial-gradient(ellipse_at_top_right,_var(--tw-gradient-stops))] from-blue-800/50 via-slate-950 to-slate-950"></div>
  <div class="mx-auto grid max-w-7xl gap-12 px-5 py-20 md:grid-cols-[1.15fr_0.85fr] md:items-center md:py-28">
    <div>
      <p class="mb-5 inline-flex items-center gap-2 rounded-full border border-blue-300/30 bg-blue-400/10 px-4 py-2 text-xs font-bold uppercase tracking-[0.18em] text-blue-200">{eyebrow}</p>
      <h1 class="max-w-3xl text-4xl font-black leading-tight tracking-tight sm:text-5xl lg:text-6xl">{titleLead} <span class="text-blue-300">{titleHighlight}</span></h1>
      <p class="mt-6 max-w-2xl text-lg leading-8 text-slate-300">{description}</p>
      <div class="mt-9 flex flex-col gap-3 sm:flex-row">
        <a href={primaryHref} class="inline-flex items-center justify-center rounded-lg bg-blue-500 px-6 py-3.5 font-bold text-white no-underline transition hover:bg-blue-400">{primaryCta} <span class="ml-2" aria-hidden="true">→</span></a>
        <a href={secondaryHref} class="inline-flex items-center justify-center rounded-lg border border-white/25 px-6 py-3.5 font-bold text-white no-underline transition hover:bg-white/10">{secondaryCta}</a>
      </div>
      <p class="mt-6 text-sm text-slate-400">{note}</p>
    </div>
    <div class="relative">
      <img src={image} alt={imageAlt} class="mx-auto mb-2 h-auto max-h-48 w-full max-w-60 object-contain" width="640" height="520" fetchpriority="high" />
      <div class="rounded-2xl border border-white/15 bg-white/[0.06] p-6 shadow-2xl backdrop-blur-sm sm:p-8">
        <h2 class="text-sm font-bold uppercase tracking-[0.16em] text-blue-200">{supportEyebrow}</h2>
        <div class="mt-6 space-y-4">
          {supportItems.map((item) => <div class="flex gap-4 rounded-xl border border-white/10 bg-slate-900/70 p-4"><span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-lg bg-blue-400/15 text-xl text-blue-200" aria-hidden="true">{item.number}</span><div><h3 class="font-bold text-white">{item.title}</h3><p class="mt-1 text-sm leading-6 text-slate-300">{item.text}</p></div></div>)}
        </div>
      </div>
      <div class="absolute -right-3 -top-3 -z-10 h-28 w-28 rounded-full bg-blue-500/30 blur-3xl"></div>
    </div>
  </div>
</section>
