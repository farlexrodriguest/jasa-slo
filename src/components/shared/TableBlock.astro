---
const { id, heading, head, rows, class: css } = Astro.props;
---
<section id={id} class={`rounded-2xl border border-slate-200 bg-white p-6 md:p-8 ${css?.section ?? ''}`}>
  {heading && <h2 class={`mb-4 text-2xl font-extrabold text-slate-950 ${css?.heading ?? ''}`}>{heading}</h2>}
  <div class={`overflow-x-auto rounded-xl border border-slate-200 ${css?.wrapper ?? ''}`}>
    <table class={`w-full text-left text-sm ${css?.table ?? ''}`}>
      <thead>
        <tr class={`border-b border-slate-200 bg-slate-50 ${css?.row ?? ''}`}>
          {head.map((h: string) => <th class={`px-4 py-3 font-semibold text-slate-950 ${css?.th ?? ''}`}>{h}</th>)}
        </tr>
      </thead>
      <tbody>
        {rows.map((row: string[], i: number) => (
          <tr class={`border-b border-slate-100 last:border-0 ${i % 2 === 1 ? 'bg-slate-50/50' : ''} ${css?.row ?? ''}`}>
            {row.map((cell: string) => <td class={`px-4 py-3 text-slate-700 ${css?.td ?? ''}`}>{cell}</td>)}
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</section>
