---
const { eyebrow, heading, message, image, homeCta, servicesCta, articlesCta } = Astro.props;
---
<div class="mx-auto flex min-h-[60vh] max-w-3xl flex-col items-center justify-center px-5 py-20 text-center">
  <img src={image} alt="" aria-hidden="true" class="mb-8 w-full max-w-xs" width="560" height="360" />
  <p class="text-sm font-extrabold uppercase tracking-[0.16em] text-blue-700">{eyebrow}</p>
  <h1 class="mt-3 text-4xl font-black tracking-tight text-slate-950 sm:text-5xl">{heading}</h1>
  <p class="mt-5 max-w-xl leading-7 text-slate-600">{message}</p>
  <div class="mt-8 flex flex-col gap-3 sm:flex-row">
    <a href="/" class="inline-flex items-center justify-center rounded-lg bg-blue-900 px-6 py-3 font-bold text-white no-underline hover:bg-blue-800 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-700">{homeCta}</a>
    <a href="/services/" class="inline-flex items-center justify-center rounded-lg border border-slate-300 px-6 py-3 font-bold text-slate-800 no-underline hover:bg-slate-50 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-700">{servicesCta}</a>
    <a href="/articles/" class="inline-flex items-center justify-center rounded-lg border border-slate-300 px-6 py-3 font-bold text-slate-800 no-underline hover:bg-slate-50 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-700">{articlesCta}</a>
  </div>
</div>
