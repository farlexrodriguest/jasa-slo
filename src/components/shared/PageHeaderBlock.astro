---
const { eyebrow, heading, intro, image, imageAlt = heading } = Astro.props;
---
<header class="grid items-center gap-8 md:grid-cols-[1.1fr_0.9fr]">
  <div class="max-w-3xl">
    <p class="text-sm font-extrabold uppercase tracking-wider text-blue-700">{eyebrow}</p>
    <h1 class="mt-3 text-4xl font-black tracking-tight text-slate-950">{heading}</h1>
    <p class="mt-4 text-lg leading-8 text-slate-600">{intro}</p>
  </div>
  <img src={image} alt={imageAlt} class="mx-auto w-full max-w-md" width="560" height="420" fetchpriority="high" />
</header>
