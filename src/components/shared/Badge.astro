---
/**
 * Badge — small status or category indicator.
 *
 * Props:
 * - variant?: 'default' | 'primary' | 'success' | 'warning' | 'danger' | 'info' — color scheme (default: 'default')
 * - size?: 'sm' | 'md' — size (default: 'md')
 *
 * Usage:
 * <Badge variant="success">Aktif</Badge>
 * <Badge variant="warning" size="sm">Pending</Badge>
 */
const {
  variant = 'default',
  size = 'md',
} = Astro.props;

const variants: Record<string, string> = {
  default: 'bg-slate-100 text-slate-700',
  primary: 'bg-blue-100 text-blue-700',
  success: 'bg-emerald-100 text-emerald-700',
  warning: 'bg-amber-100 text-amber-700',
  danger: 'bg-red-100 text-red-700',
  info: 'bg-cyan-100 text-cyan-700',
};

const sizes: Record<string, string> = {
  sm: 'text-xs px-2 py-0.5',
  md: 'text-sm px-2.5 py-0.5',
};
---
<span class={`inline-flex items-center font-semibold rounded-full ${variants[variant] ?? variants.default} ${sizes[size] ?? sizes.md}`}>
  <slot />
</span>
