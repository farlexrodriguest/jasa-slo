---
/**
 * ContentCard — kartu ringkasan dengan body opsional.
 * Body mendukung paragraf, daftar, dan gambar.
 */
const { id, heading, icon, class: css, body = [] } = Astro.props;
---
<div id={id} class={`rounded-2xl border border-slate-200 bg-white p-6 transition hover:-translate-y-1 hover:border-blue-200 hover:shadow-lg ${css?.section ?? ''}`}>
  {icon && <div class={`mb-3 text-blue-600 ${css?.icon ?? ''}`}>{icon}</div>}
  <h3 class={`text-lg font-bold text-slate-950 ${css?.heading ?? ''}`}>{heading}</h3>
  <div class="mt-3 prose-content [&>p]:text-sm [&>p]:text-slate-600 [&>ul]:text-sm [&>ul]:text-slate-600">
    {(body as any[]).map((part: any) => {
      if (part.type === 'p') return <p class={part.class}>{part.text}</p>;
      if (part.type === 'list') return part.ordered
        ? <ol class={`list-decimal pl-5 ${part.class ?? ''}`}>{part.items.map((item: string) => <li>{item}</li>)}</ol>
        : <ul class={`list-disc pl-5 ${part.class ?? ''}`}>{part.items.map((item: string) => <li>{item}</li>)}</ul>;
      if (part.type === 'image') return <figure class={part.class}><img src={part.src} alt={part.alt} class={`h-auto max-w-full rounded-lg ${part.imgClass ?? ''}`} loading="lazy" />{part.caption && <figcaption class={`mt-2 text-sm text-slate-500 ${part.captionClass ?? ''}`}>{part.caption}</figcaption>}</figure>;
      return null;
    })}
  </div>
</div>
