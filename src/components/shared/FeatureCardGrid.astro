---
/**
 * FeatureCardGrid — grid of feature cards with checkmark points.
 *
 * Props:
 * - id: string — anchor id
 * - title: string — section title
 * - columns: 2 | 3 — grid columns (default 3)
 * - items: Array<{title, description?, points?}> — feature items
 *
 * Usage:
 * <FeatureCardGrid id="features" title="Manfaat Layanan" columns={3} items={[{title: "Cepat", points: ["1-2 minggu", "Dokumen lengkap"]}]} />
 */
const { id, title, columns = 3, items } = Astro.props as { id: string; title: string; columns?: 2 | 3; items: {title: string; description?: string; points?: string[]}[] };
const titleId = `${id}-title`;
const gridClass = columns === 2 ? 'md:grid-cols-2' : 'sm:grid-cols-2 lg:grid-cols-3';
---
<section id={id} class="py-16 bg-slate-50" aria-labelledby={titleId}>
  <div class="max-w-7xl mx-auto px-5">
    <h2 id={titleId} class="text-2xl font-bold text-center text-slate-950 mb-12">{title}</h2>
    <div class={`grid gap-8 ${gridClass}`}>
      {items.map((item: {title: string; description?: string; points?: string[]}) => (
        <article class="bg-white p-8 rounded-xl shadow-sm border border-slate-200">
          <h3 class="text-xl font-bold text-slate-950 mb-4 text-blue-600">{item.title}</h3>
          {item.description && <p class="text-slate-600 leading-relaxed">{item.description}</p>}
          {item.points && (
            <ul class="space-y-3 text-slate-600">
              {item.points.map((point: string) => <li class="flex items-start"><span class="text-blue-600 font-bold mr-2" aria-hidden="true">✓</span><span>{point}</span></li>)}
            </ul>
          )}
        </article>
      ))}
    </div>
  </div>
</section>