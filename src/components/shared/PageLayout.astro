---
/**
 * PageLayout — shell untuk halaman statis (koleksi `pages`).
 *
 * Struktur: header hero gelap (eyebrow, judul, deskripsi), isi blok konten,
 * lalu CTA opsional. Identitas brand mengikuti palet espresso/cream.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from './SiteHeader.astro';
import type { CollectionEntry } from 'astro:content';
interface Props {
  page: CollectionEntry<'pages'>['data'];
  /** Judul layanan terkait (sudah diresolusi pemanggil) untuk tagline footer. */
  serviceTitle?: string;
}
const { page, serviceTitle } = Astro.props;
const showCta = page.showCta !== false;
---
<BaseLayout title={page.title} description={page.description} serviceTitle={serviceTitle}>
<SiteHeader />
<main id="main-content">
<section id="utama" class="border-b border-[#dfcdb8] bg-[#2a1a0e] text-[#fef3e2]">
<div class="mx-auto max-w-[1440px] px-6 py-20 lg:px-12 lg:py-28">
{page.eyebrow && <p class="eyebrow text-[#f4ae52]">{page.eyebrow}</p>}
<h1 class="mt-6 max-w-4xl text-[clamp(2.8rem,6vw,6rem)] font-extrabold leading-[1.04]">{page.title}</h1>
<p class="mt-8 max-w-2xl text-lg leading-8 text-[#e0cbb9]">{page.description}</p>
</div>
</section>
<section id="isi" class="mx-auto max-w-3xl px-6 py-20 lg:py-28">
<div class="page-body text-lg leading-8 text-[#594332]"><slot /></div>
</section>
{showCta && <section id="klarifikasi" class="border-t border-[#dfcdb8] bg-[#f4ae52]"><div class="mx-auto flex max-w-[1440px] flex-wrap items-center justify-between gap-8 px-6 py-16 lg:px-12"><div><p class="eyebrow">Perlu klarifikasi?</p><h2 class="mt-4 text-3xl font-extrabold md:text-5xl">Siapkan kebutuhan instalasi Anda.</h2></div><a href="/kontak/" class="bg-[#2a1a0e] px-7 py-4 font-bold text-[#fef3e2] hover:bg-[#5b3420]">Halaman kontak ↗</a></div></section>}
</main>
</BaseLayout>
