---
import { getCollection } from 'astro:content';
import { ui } from '../../config/ui.ts';
const { id, eyebrow, heading, description, variant = 'listing', columns = 3, showBenefits = false } = Astro.props;
const services = (await getCollection('services')).filter((service) => !service.data.draft && service.data.status === 'active').sort((a, b) => a.data.order - b.data.order);
const Heading = variant === 'home' ? 'h3' : 'h2';
const serviceBenefitItems = (service: import('astro:content').CollectionEntry<'services'>) => {
  const block = service.data.blocks.find((item) => item.component === 'feature-card-grid');
  return block?.items.slice(0, 3).map((item) => item.title) ?? [];
};
---
<section id={id} class={variant === 'home' ? 'scroll-mt-8 bg-white py-20 sm:py-24' : 'mt-10'}>
  <div class={variant === 'home' ? 'mx-auto max-w-7xl px-5' : ''}>
    {(eyebrow || heading || description) && <div class={variant === 'home' ? 'max-w-2xl' : 'max-w-3xl'}>
      {eyebrow && <p class="text-sm font-extrabold uppercase tracking-[0.16em] text-blue-700">{eyebrow}</p>}
      {heading && <h2 class={variant === 'home' ? 'mt-3 text-3xl font-black tracking-tight text-slate-950 sm:text-4xl' : 'text-2xl font-black tracking-tight text-slate-950'}>{heading}</h2>}
      {description && <p class="mt-4 leading-7 text-slate-600">{description}</p>}
    </div>}
    {services.length ? <div class:list={[variant === 'home' ? 'mt-10 grid gap-5 md:grid-cols-3' : 'grid gap-5 md:grid-cols-2 lg:grid-cols-3', columns === 2 && 'md:grid-cols-2 lg:grid-cols-2']}>
      {services.map((service, index) => <article class:list={['flex h-full flex-col rounded-2xl border border-slate-200 bg-white p-6', variant === 'home' && 'transition hover:-translate-y-1 hover:border-blue-200 hover:shadow-xl hover:shadow-slate-200/60']}>
        {variant === 'home' ? <p class="text-sm font-black tracking-widest text-blue-700">{String(index + 1).padStart(2, '0')}</p> : <p class="text-xs font-bold uppercase tracking-wider text-blue-700">{service.data.serviceGroup.toUpperCase()}</p>}
        <Heading class="mt-3 text-xl font-extrabold leading-snug text-slate-950">{service.data.title}</Heading>
        <p class="mt-3 flex-1 text-sm leading-7 text-slate-600">{service.data.description}</p>
        {showBenefits && serviceBenefitItems(service).length > 0 && <ul class="mt-5 space-y-3 border-t border-slate-100 pt-5 text-sm text-slate-700">{serviceBenefitItems(service).map((point) => <li class="flex gap-2"><span class="font-bold text-blue-700" aria-hidden="true">✓</span><span>{point}</span></li>)}</ul>}
        <a href={`/services/${service.data.slug}/`} class="mt-6 font-bold text-blue-700 no-underline hover:text-blue-900">{ui.services.readMore}</a>
      </article>)}
    </div> : <p class="mt-10 rounded-xl border border-dashed border-slate-300 p-8 text-slate-500">{ui.services.emptyList}</p>}
  </div>
</section>
